# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000

# Lab 3 — origin the API accepts credentialed (cookie-bearing) requests from.
# Must match the client dev server's actual origin exactly.
CLIENT_ORIGIN="http://localhost:5173"

# Lab 3 — local development only. Every seeded User (Requester, IT Staff,
# Administrator) shares this default password and has mustChangePassword
# set to true, so it only ever gets someone past the forced Change Password
# screen once. This is NOT a real secret — never put a real password here or
# in any committed file. See docs/lab-03/specification.md §7.5.
SEED_DEFAULT_PASSWORD="ChangeMe123!"
